<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo en la build de debug (ver src/debug/AndroidManifest.xml). Permite
    tráfico HTTP sin cifrar ÚNICAMENTE hacia la IP local del backend de
    desarrollo — nunca hacia ningún otro host. La build de release no
    incluye este archivo, así que ahí solo funciona HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.116</domain>
    </domain-config>
</network-security-config>
