<?xml version="1.0" encoding="utf-8"?>
<!--
   Nota: este archivo solo lo usan los dispositivos anteriores a Android 12
   (API 31); los demás usan data_extraction_rules.xml. minSdk de NEXO es 26,
   así que ambos deben excluir la base de datos.
-->
<full-backup-content>
    <exclude domain="database" path="nexo_database" />
    <exclude domain="database" path="nexo_database-wal" />
    <exclude domain="database" path="nexo_database-shm" />
</full-backup-content>
