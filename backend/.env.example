DJANGO_SECRET_KEY=CAMBIAR_ESTA_CONTRASENA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://nexo_user:CAMBIAR_ESTA_CONTRASENA@localhost:5432/nexo_backend

# Correo (códigos de verificación e informes por correo). EMAIL_HOST_USER es
# la cuenta de Gmail que manda los correos del proyecto; EMAIL_HOST_PASSWORD
# es una "contraseña de aplicación" de esa cuenta (no la contraseña normal
# de Gmail) — se genera en https://myaccount.google.com/apppasswords con la
# verificación en dos pasos de esa cuenta de Google activada.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nexoproyect7@gmail.com
EMAIL_HOST_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEFAULT_FROM_EMAIL=nexoproyect7@gmail.com
